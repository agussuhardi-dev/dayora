# PostgreSQL. Remote host example: jdbc:postgresql://db.example.com:5432/dayora?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/dayora
DATABASE_USERNAME=dayora
DATABASE_PASSWORD=change-me

# Server
SERVER_PORT=8080
SESSION_COOKIE_SECURE=false
DAYORA_WS_ORIGINS=http://localhost:4200

# First admin only; remove after account creation
DAYORA_BOOTSTRAP_ADMIN_USERNAME=
DAYORA_BOOTSTRAP_ADMIN_PASSWORD=

# Optional Firebase Cloud Messaging (backend)
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/dayora-firebase.json
FIREBASE_CREDENTIALS_FILE=./secrets/dayora-firebase.json
# Firebase Web app public configuration; create a Web app and Web Push certificate in Firebase Console.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_VAPID_KEY=

# Cloudflare Tunnel token (keep secret; set tunnel hostname service to http://frontend:80)
CLAUDEFIRE_TUNNEL=
